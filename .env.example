# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql://sitesync:sitesync_password@localhost:5432/sitesync_db?schema=public"

# Redis & Queues
REDIS_URL="redis://localhost:6379"

# AI & LLM Provider Configuration (Optional - Offline deterministic fallback active by default)
LLM_PROVIDER="fallback" # options: "openai", "anthropic", "gemini", "ollama", "fallback"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"
