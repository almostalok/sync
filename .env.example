# SiteSync Enterprise Environment Configuration (SIH26122)
# Copy this file to .env or .env.local for local development

# 1. Server & Host Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# 2. Database & State Store
DATABASE_URL="postgresql://sitesync:sitesync_secure_pass@localhost:5432/sitesync_prod?schema=public"
PRISMA_CLI_BINARY_TARGETS="native"

# 3. Cache & Message Broker (Redis)
REDIS_URL="redis://:sitesync_redis_pass@localhost:6379/0"
REDIS_KEY_PREFIX="sitesync:"

# 4. AI & Embeddings Configuration
AI_PROVIDER=deterministic-simulated # Options: deterministic-simulated, openai, anthropic, azure-openai
AI_MODEL=completion-xgb-v1.4
EMBEDDING_PROVIDER=synthetic-domain # Options: synthetic-domain, text-embedding-3-small, sentence-transformers
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=sk-demo-simulation-key-not-required-for-synthetic-tests

# 5. Object Storage (S3 / MinIO / Local)
STORAGE_PROVIDER=local # Options: local, s3, minio
STORAGE_BUCKET=sitesync-evidence-vault
STORAGE_LOCAL_PATH=./data/storage
STORAGE_MAX_FILE_SIZE_MB=25

# 6. Supervisor Voice Ingestion
VOICE_PROVIDER=deterministic-whisper # Options: deterministic-whisper, openai-whisper, deepgram
VOICE_SAMPLE_RATE=16000
VOICE_MAX_DURATION_SECONDS=120

# 7. Security & Session
JWT_SECRET=sitesync_enterprise_jwt_secret_change_in_production_981273981273
SESSION_EXPIRY_HOURS=12
CORS_ORIGINS=http://localhost:3000

# 8. Deterministic Evaluation & Demo Seed
DEMO_SEED=42
DATASET_VERSION=synthetic-compressor-v1
